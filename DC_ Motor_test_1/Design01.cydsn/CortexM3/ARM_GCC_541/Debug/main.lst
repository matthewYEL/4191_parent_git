 245:main.c        **** /*
 246:main.c        ****  * Read one whitespace-delimited token starting at p into out
 247:main.c        ****  * (truncated to out_size-1 chars), skip any leading/trailing
 248:main.c        ****  * spaces, and return the position right after the token.
 249:main.c        ****  */
 250:main.c        **** char* read_token(char *p, char *out, int out_size)
 251:main.c        **** {
 252:main.c        ****     while (*p == ' ')
 253:main.c        ****     {
 254:main.c        ****         p++;
 255:main.c        ****     }
 256:main.c        **** 
 257:main.c        ****     /* Accept fd3/bk3 as fd 3/bk 3. Return the command now and leave
 258:main.c        ****      * its count for the next token read, including inside command bodies.
 259:main.c        ****      * Only split a complete numeric suffix, not names such as fd3abc.
 260:main.c        ****      */
 261:main.c        ****     if (out_size >= 3 &&
 262:main.c        ****         (strncmp(p, "fd", 2) == 0 || strncmp(p, "bk", 2) == 0) &&
 263:main.c        ****         isdigit((unsigned char)p[2]))
 264:main.c        ****     {
 265:main.c        ****         char *end = p + 2;
 266:main.c        ****         while (isdigit((unsigned char)*end)) end++;
ARM GAS  C:\Users\ywlim\AppData\Local\Temp\ccloBxFa.s 			page 17


 267:main.c        ****         if (*end == ' ' || *end == '\0')
 268:main.c        ****         {
 269:main.c        ****             out[0] = p[0];
 270:main.c        ****             out[1] = p[1];
 271:main.c        ****             out[2] = '\0';
 272:main.c        ****             return p + 2;
 273:main.c        ****         }
 274:main.c        ****     }
 275:main.c        **** 
 276:main.c        ****     int j = 0;
 277:main.c        ****     while (*p != ' ' && *p != '\0' && j < out_size - 1)
 278:main.c        ****     {
 279:main.c        ****         out[j++] = *p;
 280:main.c        ****         p++;
 281:main.c        ****     }
 282:main.c        ****     out[j] = '\0';
 283:main.c        **** 
 284:main.c        ****     while (*p == ' ')
 285:main.c        ****     {
 286:main.c        ****         p++;
 287:main.c        ****     }
 288:main.c        **** 
 289:main.c        ****     return p;
 290:main.c        **** }
 291:main.c        **** 
 292:main.c        **** /*
 293:main.c        ****  * Turn a "fd/bk/lt/rt <value>" pair into one TurtleCommand and
 294:main.c        ****  * append it to queue[*count]. Returns 1 if a command was added,
 295:main.c        ****  * 0 if the queue was full or cmd_name was not recognized.
 296:main.c        ****  */
 297:main.c        **** int append_simple_command(TurtleCommand *queue, volatile int *count, int max_count,
 298:main.c        ****                            const char *cmd_name, int value)
 299:main.c        **** {
 300:main.c        ****     if (*count >= max_count)
 301:main.c        ****     {
 302:main.c        ****         return 0;
 303:main.c        ****     }
 304:main.c        **** 
 305:main.c        ****     queue[*count].repeat_cnt = 1;
 306:main.c        ****     queue[*count].turn_delta_deg = 0;
 307:main.c        **** 
 308:main.c        ****     if (strcmp(cmd_name, "fd") == 0 || strcmp(cmd_name, "bk") == 0)
 309:main.c        ****     {
 310:main.c        ****         /* Store the raw grid-step count (signed for direction). The
 311:main.c        ****          * actual pulse target depends on the heading at the moment
 312:main.c        ****          * this command is executed, so it's computed at runtime in
 313:main.c        ****          * main() instead of here. */
 314:main.c        ****         int forward = (cmd_name[0] == 'f');
 315:main.c        **** 
 316:main.c        ****         queue[*count].type = forward ? 'f' : 'b';
 317:main.c        ****         queue[*count].param = forward ? -value : value;
 318:main.c        ****     }
 319:main.c        **** 
 320:main.c        ****     else if (strcmp(cmd_name, "lt") == 0 || strcmp(cmd_name, "rt") == 0)
 321:main.c        ****     {
 322:main.c        ****         int pulses;
 323:main.c        ****         pulses = angle_to_pulses_rt(value);
ARM GAS  C:\Users\ywlim\AppData\Local\Temp\ccloBxFa.s 			page 18


 324:main.c        ****         
 325:main.c        ****         if (pulses == 0)
 326:main.c        ****         {
 327:main.c        ****             /* angle not in the supported 45-degree table -> skip this command */
 328:main.c        ****             uart_printf("INVALID ANGLE: %d (use 45/90/135/180/225/270/315)\r\n", value);
 329:main.c        ****             return 0;
 330:main.c        ****         }
 331:main.c        **** 
 332:main.c        ****         int left = (cmd_name[0] == 'l');
 333:main.c        **** 
 334:main.c        ****         queue[*count].type = left ? 'l' : 'r';
 335:main.c        ****         queue[*count].param = left ? -pulses : pulses;
 336:main.c        ****         queue[*count].turn_delta_deg = left ? -value : value;
 337:main.c        ****     }
 338:main.c        ****     else
 339:main.c        ****     {
 340:main.c        ****         return 0;
 341:main.c        ****     }
 342:main.c        **** 
 343:main.c        ****     (*count)++;
 344:main.c        ****     return 1;
 345:main.c        **** }
