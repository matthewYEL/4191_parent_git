 506:main.c        **** char* find_matching_bracket(char *start)
 507:main.c        **** {
 508:main.c        ****     int depth = 0;
 509:main.c        **** 
 510:main.c        ****     while (*start != '\0')
 511:main.c        ****     {
 512:main.c        ****         if (*start == '[')
 513:main.c        ****         {
 514:main.c        ****             depth++;
 515:main.c        ****         }
 516:main.c        ****         else if (*start == ']')
 517:main.c        ****         {
 518:main.c        ****             depth--;
 519:main.c        **** 
 520:main.c        ****             if (depth == 0)
 521:main.c        ****             {
 522:main.c        ****                 return start;
 523:main.c        ****             }
 524:main.c        ****         }
 525:main.c        **** 
 526:main.c        ****         start++;
 527:main.c        ****     }
 528:main.c        **** 
 529:main.c        ****     return NULL;
 530:main.c        **** }
