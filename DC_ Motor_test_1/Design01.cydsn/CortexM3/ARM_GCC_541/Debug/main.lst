1288:main.c        **** /* Camera protocol: one A/E/I/O/U or N byte per detection (either case).
1289:main.c        ****  * Camera TX -> UART_2 RX (P15[5]); UART_2 TX (P12[7]) -> USB-UART RX.
1290:main.c        ****  * Updates :vowel for existing conditions and reports detections to Termite.
1291:main.c        ****  * Drain/discard during motion and settling. After the settling interval,
1292:main.c        ****  * flush once more and require a newly received valid byte before proceeding.
1293:main.c        ****  */
1294:main.c        **** static void check_camera_uart(void)
1295:main.c        **** {
