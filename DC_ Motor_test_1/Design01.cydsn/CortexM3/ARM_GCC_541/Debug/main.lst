 205:main.c        **** /*
 206:main.c        ****  * Read one whitespace-delimited token starting at p into out
 207:main.c        ****  * (truncated to out_size-1 chars), skip any leading/trailing
 208:main.c        ****  * spaces, and return the position right after the token.
 209:main.c        ****  */
 210:main.c        **** char* read_token(char *p, char *out, int out_size)
 211:main.c        **** {
 212:main.c        ****     while (*p == ' ')
ARM GAS  C:\Users\ywlim\AppData\Local\Temp\ccBfb4lD.s 			page 14


 213:main.c        ****     {
 214:main.c        ****         p++;
 215:main.c        ****     }
 216:main.c        **** 
 217:main.c        ****     /* Accept fd3/bk3 as fd 3/bk 3. Return the command now and leave
 218:main.c        ****      * its count for the next token read, including inside command bodies.
 219:main.c        ****      * Only split a complete numeric suffix, not names such as fd3abc.
 220:main.c        ****      */
 221:main.c        ****     if (out_size >= 3 &&
 222:main.c        ****         (strncmp(p, "fd", 2) == 0 || strncmp(p, "bk", 2) == 0) &&
 223:main.c        ****         isdigit((unsigned char)p[2]))
 224:main.c        ****     {
 225:main.c        ****         char *end = p + 2;
 226:main.c        ****         while (isdigit((unsigned char)*end)) end++;
 227:main.c        ****         if (*end == ' ' || *end == '\0')
 228:main.c        ****         {
 229:main.c        ****             out[0] = p[0];
 230:main.c        ****             out[1] = p[1];
 231:main.c        ****             out[2] = '\0';
 232:main.c        ****             return p + 2;
 233:main.c        ****         }
 234:main.c        ****     }
 235:main.c        **** 
 236:main.c        ****     int j = 0;
 237:main.c        ****     while (*p != ' ' && *p != '\0' && j < out_size - 1)
 238:main.c        ****     {
 239:main.c        ****         out[j++] = *p;
 240:main.c        ****         p++;
 241:main.c        ****     }
 242:main.c        ****     out[j] = '\0';
 243:main.c        **** 
 244:main.c        ****     while (*p == ' ')
 245:main.c        ****     {
 246:main.c        ****         p++;
 247:main.c        ****     }
 248:main.c        **** 
 249:main.c        ****     return p;
 250:main.c        **** }
 251:main.c        **** 
 252:main.c        **** /*
 253:main.c        ****  * Turn a "fd/bk/lt/rt <value>" pair into one TurtleCommand and
 254:main.c        ****  * append it to queue[*count]. Returns 1 if a command was added,
 255:main.c        ****  * 0 if the queue was full or cmd_name was not recognized.
 256:main.c        ****  */
 257:main.c        **** int append_simple_command(TurtleCommand *queue, volatile int *count, int max_count,
 258:main.c        ****                            const char *cmd_name, int value)
 259:main.c        **** {
 260:main.c        ****     if (*count >= max_count)
 261:main.c        ****     {
 262:main.c        ****         return 0;
 263:main.c        ****     }
 264:main.c        **** 
 265:main.c        ****     queue[*count].repeat_cnt = 1;
 266:main.c        ****     queue[*count].turn_delta_deg = 0;
 267:main.c        **** 
 268:main.c        ****     if (strcmp(cmd_name, "fd") == 0 || strcmp(cmd_name, "bk") == 0)
 269:main.c        ****     {
ARM GAS  C:\Users\ywlim\AppData\Local\Temp\ccBfb4lD.s 			page 15


 270:main.c        ****         /* Store the raw grid-step count (signed for direction). The
 271:main.c        ****          * actual pulse target depends on the heading at the moment
 272:main.c        ****          * this command is executed, so it's computed at runtime in
 273:main.c        ****          * main() instead of here. */
 274:main.c        ****         int forward = (cmd_name[0] == 'f');
 275:main.c        **** 
 276:main.c        ****         queue[*count].type = forward ? 'f' : 'b';
 277:main.c        ****         queue[*count].param = forward ? -value : value;
 278:main.c        ****     }
 279:main.c        ****     else if (strcmp(cmd_name, "lt") == 0 || strcmp(cmd_name, "rt") == 0)
 280:main.c        ****     {
 281:main.c        ****         int pulses = angle_to_pulses(value);
 282:main.c        **** 
 283:main.c        ****         if (pulses == 0)
 284:main.c        ****         {
 285:main.c        ****             /* angle not in the supported 45-degree table -> skip this command */
 286:main.c        ****             uart_printf("INVALID ANGLE: %d (use 45/90/135/180/225/270/315)\r\n", value);
 287:main.c        ****             return 0;
 288:main.c        ****         }
 289:main.c        **** 
 290:main.c        ****         int left = (cmd_name[0] == 'l');
 291:main.c        **** 
 292:main.c        ****         queue[*count].type = left ? 'l' : 'r';
 293:main.c        ****         queue[*count].param = left ? -pulses : pulses;
 294:main.c        ****         queue[*count].turn_delta_deg = left ? -value : value;
 295:main.c        ****     }
 296:main.c        ****     else
 297:main.c        ****     {
 298:main.c        ****         return 0;
 299:main.c        ****     }
 300:main.c        **** 
 301:main.c        ****     (*count)++;
 302:main.c        ****     return 1;
 303:main.c        **** }
