1311:main.c        **** /* Print every raw byte waiting in UART_2's buffer, then discard it.
1312:main.c        ****  * Used anywhere we'd otherwise call UART_2_ClearRxBuffer() silently. */
1313:main.c        **** static void drain_and_print_camera_bytes(void)
1314:main.c        **** {
1315:main.c        ****     while (UART_2_GetRxBufferSize() > 0u)
1316:main.c        ****     {
1317:main.c        ****         uint8 b = UART_2_GetChar();
1318:main.c        **** 
1319:main.c        ****         if (b >= 0x20 && b <= 0x7E)
1320:main.c        ****         {
1321:main.c        ****             uart_printf("CAM RAW: 0x%02X '%c'\r\n", b, b);
1322:main.c        ****         }
1323:main.c        ****         else
1324:main.c        ****         {
1325:main.c        ****             uart_printf("CAM RAW: 0x%02X\r\n", b);
1326:main.c        ****         }
1327:main.c        ****     }
1328:main.c        **** }
1329:main.c        **** 
1330:main.c        **** /* Camera protocol: one A/E/I/O/U or N byte per detection (either case).
1331:main.c        ****  * Camera TX -> UART_2 RX (P15[5]); UART_2 TX (P12[7]) -> USB-UART RX.
1332:main.c        ****  * Updates :vowel for existing conditions and reports detections to Termite.
1333:main.c        ****  * Drain/discard during motion and settling. After the settling interval,
1334:main.c        ****  * flush once more and require a newly received valid byte before proceeding.
