 153:main.c        **** /* Is the given heading (a multiple of 45 degrees) a diagonal grid direction? */
 154:main.c        **** int heading_is_diagonal(float heading_deg)
 155:main.c        **** {
 156:main.c        ****     int h = ((int)heading_deg) % 360;
 157:main.c        ****     if (h < 0)
 158:main.c        ****     {
 159:main.c        ****         h += 360;
 160:main.c        ****     }
 161:main.c        ****     return (h % 90) != 0;
 162:main.c        **** }
