1269:main.c        **** /* Print every raw byte waiting in UART_2's buffer, then discard it.
1270:main.c        ****  * Used anywhere we'd otherwise call UART_2_ClearRxBuffer() silently. */
1271:main.c        **** static void drain_and_print_camera_bytes(void)
1272:main.c        **** {
1273:main.c        ****     while (UART_2_GetRxBufferSize() > 0u)
1274:main.c        ****     {
1275:main.c        ****         uint8 b = UART_2_GetChar();
1276:main.c        **** 
1277:main.c        ****         if (b >= 0x20 && b <= 0x7E)
1278:main.c        ****         {
1279:main.c        ****             uart_printf("CAM RAW: 0x%02X '%c'\r\n", b, b);
1280:main.c        ****         }
1281:main.c        ****         else
1282:main.c        ****         {
1283:main.c        ****             uart_printf("CAM RAW: 0x%02X\r\n", b);
1284:main.c        ****         }
1285:main.c        ****     }
1286:main.c        **** }
