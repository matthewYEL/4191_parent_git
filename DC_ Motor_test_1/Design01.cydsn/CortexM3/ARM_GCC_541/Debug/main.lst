 150:main.c        **** /*
 151:main.c        ****  * Read one whitespace-delimited token starting at p into out
 152:main.c        ****  * (truncated to out_size-1 chars), skip any leading/trailing
 153:main.c        ****  * spaces, and return the position right after the token.
 154:main.c        ****  */
 155:main.c        **** char* read_token(char *p, char *out, int out_size)
 156:main.c        **** {
 157:main.c        ****     while (*p == ' ')
 158:main.c        ****     {
 159:main.c        ****         p++;
 160:main.c        ****     }
 161:main.c        **** 
ARM GAS  C:\Users\ywlim\AppData\Local\Temp\ccq97c7R.s 			page 9


 162:main.c        ****     /* Accept fd3/bk3 as fd 3/bk 3. Return the command now and leave
 163:main.c        ****      * its count for the next token read, including inside command bodies.
 164:main.c        ****      * Only split a complete numeric suffix, not names such as fd3abc.
 165:main.c        ****      */
 166:main.c        ****     if (out_size >= 3 &&
 167:main.c        ****         (strncmp(p, "fd", 2) == 0 || strncmp(p, "bk", 2) == 0) &&
 168:main.c        ****         isdigit((unsigned char)p[2]))
 169:main.c        ****     {
 170:main.c        ****         char *end = p + 2;
 171:main.c        ****         while (isdigit((unsigned char)*end)) end++;
 172:main.c        ****         if (*end == ' ' || *end == '\0')
 173:main.c        ****         {
 174:main.c        ****             out[0] = p[0];
 175:main.c        ****             out[1] = p[1];
 176:main.c        ****             out[2] = '\0';
 177:main.c        ****             return p + 2;
 178:main.c        ****         }
 179:main.c        ****     }
 180:main.c        **** 
 181:main.c        ****     int j = 0;
 182:main.c        ****     while (*p != ' ' && *p != '\0' && j < out_size - 1)
 183:main.c        ****     {
 184:main.c        ****         out[j++] = *p;
 185:main.c        ****         p++;
 186:main.c        ****     }
 187:main.c        ****     out[j] = '\0';
 188:main.c        **** 
 189:main.c        ****     while (*p == ' ')
 190:main.c        ****     {
 191:main.c        ****         p++;
 192:main.c        ****     }
 193:main.c        **** 
 194:main.c        ****     return p;
 195:main.c        **** }
 196:main.c        **** 
 197:main.c        **** /*
 198:main.c        ****  * Turn a "fd/bk/lt/rt <value>" pair into one TurtleCommand and
 199:main.c        ****  * append it to queue[*count]. Returns 1 if a command was added,
 200:main.c        ****  * 0 if the queue was full or cmd_name was not recognized.
